# Copy to `.env` for local development. `.env` is gitignored — these are
# secrets and must never be committed. In production they're set in the Vercel
# dashboard instead (Settings → Environment Variables), not from this file.
#
# Both come from the GitHub OAuth App (github.com → Settings → Developer
# settings → OAuth Apps). See docs/editing-content.md, Part 1.

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Optional. Overrides the site's canonical URL, which otherwise comes from
# Vercel's own environment in production and falls back to localhost.
# SITE_URL=https://4atatime.com
