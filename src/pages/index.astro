---
// The whole site is this one page. Works live in the graph; About & Contact
// lives in a template that the pop-up window clones on demand. There is no nav
// bar, and no separate routes — the hash is the router (see
// ../scripts/window.ts), which keeps every work shareable anyway. The category
// filter rides in the query string (../scripts/filter.ts), so a filtered view
// is shareable too.
import { getCollection } from 'astro:content';
import AboutContact from '../components/AboutContact.astro';
import BaseHead from '../components/BaseHead.astro';
import Controls from '../components/Controls.astro';
import CornerNav from '../components/CornerNav.astro';
import CustomCursor from '../components/CustomCursor.astro';
import DetailWindow from '../components/DetailWindow.astro';
import Footer from '../components/Footer.astro';
import GraphView from '../components/GraphView.astro';
import StationBox from '../components/StationBox.astro';
import WorkDetailContent from '../components/WorkDetailContent.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { buildGraph } from '../lib/graph';

const items = await getCollection('work');
const graph = buildGraph(items);
const byId = new Map(items.map((item) => [item.id, item]));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<CustomCursor />

		<h1 class="sr-only">{SITE_TITLE}</h1>

		<StationBox />
		<Controls />

		<main>
			<GraphView data={graph} />
		</main>

		<div class="bottom-bar">
			<CornerNav />
			<Footer />
		</div>

		<DetailWindow />

		<template data-panel="about"><AboutContact /></template>
		{
			graph.nodes.map((node) => (
				<template data-panel={`work/${node.id}`}>
					<WorkDetailContent item={byId.get(node.id)!} />
				</template>
			))
		}

		<style>
			/* One bar across the bottom rather than two independently placed
			   corners: it's what actually guarantees the links and the copyright
			   share a baseline, and it can't overlap on a narrow screen. */
			.bottom-bar {
				position: fixed;
				left: 0;
				right: 0;
				bottom: var(--edge);
				z-index: 50;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1.5rem;
				padding: 0 var(--edge);
				/* The bar spans the viewport, so it must not intercept drags meant
				   for the graph — only its actual links do. */
				pointer-events: none;
			}

			@media (max-width: 720px) {
				.bottom-bar {
					gap: 1rem;
				}
			}

			/* Side by side, the buttons and the copyright collide on a phone and
			   the copyright wraps over them. Stacked, the buttons stay on the
			   bottom edge where the thumb is and the line sits above. */
			@media (max-width: 560px) {
				.bottom-bar {
					flex-direction: column-reverse;
					align-items: flex-start;
					gap: 0.65rem;
				}
			}
		</style>
	</body>
</html>
