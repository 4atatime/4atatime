---
// The shell of every page in the low-tech mirror (/low-tech/): the same works
// and words as the main site, as plain HTML. Modelled on Low←Tech Magazine's
// solar site and the web of the early 2000s:
//
//   · no JavaScript, no web fonts, no cookies, nothing fetched from elsewhere —
//     the text is set in whatever the browser's own default is;
//   · the browser's own colours, too: blue links that turn purple once
//     visited, grey rules, and a dark page if the visitor's system is dark
//     (`color-scheme`) — the only "theme switch" a page needs;
//   · in place of a logo, one typographic move, after Low←Tech Magazine's
//     arrow: 4atatime ←low-tech, and the way back is the
//     (unnecessarily) graphic heavy→ version (Lexie's name for it);
//   · the page says what it weighs, measured off the built files by
//     src/integrations/page-weight.mjs (in `astro dev` it says so instead);
//   · a few kaomoji, four at most across the whole mirror (Lexie's limit):
//     the hello, mμsic, the sign-off, and this door. Hidden from screen
//     readers, which would read them out glyph by glyph.
//
// Dashes: none of the long ones, by request (2026-10-06). An aside takes a
// spaced hyphen, a path takes >>, and the arrows stay arrows.
//
// Deliberately not BaseHead.astro: that pulls in the main site's stylesheet
// and four web fonts, which is most of what this version exists to leave out.
// The little CSS there is is inline, so a page is one request plus pictures.
import { SITE_DESCRIPTION } from '../consts';
import { LOW_TECH } from '../lib/low-tech';

interface Props {
	title: string;
	description?: string;
	/** Where the door to the graphic-heavy version opens: the same work in the field, or the front page. */
	heavy: string;
}

const { title, description = SITE_DESCRIPTION, heavy } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const built = new Date();
const builtOn = built.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<style is:inline>
			/* Side margins run from 40px on a phone to 260px on a wide
			   screen, along a line through 180px at 1024px; top and bottom
			   from 40px to 80px. (Lexie, 2026-10-06.) */
			/* Text from 17px on a phone to 20px on a wide screen; 16px, the
			   browser's own, read small (Lexie, 2026-10-21). Small print
			   comes out at 14-17px, never under the 14px floor for
			   secondary text. Set on the body in rem, so a visitor who has
			   raised their browser's text size still gets theirs, raised. */
			body {
				margin: 0;
				padding: clamp(40px, 5.5vw, 80px) clamp(40px, 22vw - 46px, 260px);
				font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.25rem);
				line-height: 1.5;
			}
			small {
				font-size: 0.85em;
			}
			/* A paragraph of small print spaced by its own size, not by the
			   larger text around it, which left it double-spaced. */
			.door small,
			p > small:only-child {
				display: block;
			}
			/* So the padding is the whole gap, not the padding plus a
			   paragraph's own margin. */
			body > p:first-of-type {
				margin-top: 0;
			}
			body > p:last-of-type {
				margin-bottom: 0;
			}
			img {
				max-width: 100%;
				height: auto;
			}
			/* The dithered pictures are grey; the browser tints them by
			   collection, multiplying the grey into the colour behind it. */
			.tint {
				display: inline-block;
				max-width: 100%;
				line-height: 0;
				vertical-align: top;
			}
			.tint img {
				mix-blend-mode: multiply;
			}
			.swatch {
				display: inline-block;
				width: 0.8em;
				height: 0.8em;
				border: 1px solid;
			}
			.uiux { background: #99cccc; }
			.grafix { background: #ffcc99; }
			.ink { background: #ccccff; }
			.music { background: #ccff99; }
			/* Drawn pixel for pixel wherever the column is at least as wide as
			   the 600px pictures (from about 907px, given the margins above),
			   so the dither stays a dither instead of being smoothed into grey. */
			@media (min-width: 57em) {
				.tint img {
					image-rendering: pixelated;
				}
			}
			table {
				border-collapse: collapse;
			}
			th {
				text-align: left;
				vertical-align: top;
			}
			/* The door to the main site is the one thing on the page that
			   should look pressable: a raised, early-2000s button, its link
			   set large (Lexie, 2026-10-21). */
			.door {
				border: 3px outset ButtonBorder;
				padding: 0.7em 0.9em;
			}
			.door big {
				font-size: 1.3em;
				line-height: 1.3;
			}
			.copyleft {
				text-decoration: none;
			}
			.copyleft svg {
				width: 0.9em;
				height: 0.9em;
				vertical-align: -0.1em;
			}
			.still {
				display: none;
			}
			@media (prefers-reduced-motion: reduce) {
				marquee {
					display: none;
				}
				.still {
					display: block;
				}
			}
			.badge {
				display: inline-block;
				border: 1px solid;
				padding: 0 0.4em;
				font: 12px/1.6 Verdana, sans-serif;
				text-transform: uppercase;
			}
		</style>
	</head>
	<body>
		<a id="top"></a>
		<p>
			<big><b><a href={LOW_TECH}>4atatime</a> &larr;low-tech</b></big>
		</p>

		<p class="door">
			<big><b><a href={heavy}>Take me to the (unnecessarily) graphic heavy&rarr; version</a></b></big>
			<span aria-hidden="true">&nbsp;𖦹ׂ ₊˚⊹⋆</span>
			<br />
			<small>
				Exactly the same content as here but fun and cute graphview playground, a little heavier on your
				device (and the planet, although just a little).
			</small>
		</p>

		<p>
			[ <a href={`${LOW_TECH}#works`}>works</a> | <a href={`${LOW_TECH}#about`}>about &amp; contact</a> |{' '}
			<a href={heavy}>(unnecessarily) graphic heavy&rarr;</a> ]
		</p>

		<hr />

		<slot />

		<hr />

		<p>
			<small>
				This page weighs <b><!--weight-->(measured when the site is built)<!--/weight--></b>, pictures
				included. No JavaScript, no web fonts, no cookies, no tracking. After{' '}
				<a href="https://solar.lowtechmagazine.com/">Low&larr;Tech Magazine</a>.
				<br />
				Built from the same files as the <a href={heavy}>(unnecessarily) graphic heavy&rarr; version</a>, so the two are always the
				same: last updated {builtOn}.
				<br />
				<a class="copyleft" href="https://en.wikipedia.org/wiki/All_rights_reversed" title="Copyleft"
					><svg viewBox="0 0 100 100" role="img" aria-label="Copyleft"
						><circle cx="50" cy="50" r="43" fill="none" stroke="currentColor" stroke-width="12" /><path
							d="M30 37 A24 24 0 1 1 30 63"
							fill="none"
							stroke="currentColor"
							stroke-width="12"></path></svg
					></a
				>{' '}
				{built.getFullYear()} Lexie Yu. All rights reversed. [ <a href="#top">top</a> ]
			</small>
		</p>
		<p><span class="badge">best viewed with any browser</span></p>
	</body>
</html>
