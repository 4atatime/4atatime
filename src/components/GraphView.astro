---
// The homepage itself: every work scattered in a 3D field and clustered by
// similarity. Canvas does the drawing (see ../scripts/graph.ts); the hover
// preview is a DOM element so it can be styled with real CSS rather than
// hand-measured on a canvas.
//
// The canvas is invisible to assistive tech, so the same works are also
// emitted as a visually-hidden list of links. Those links carry the same
// #work/<id> hashes the nodes do, so keyboard and screen-reader users open
// exactly the same windows by exactly the same mechanism.
import type { GraphData } from '../lib/graph';

interface Props {
	data: GraphData;
}

const { data } = Astro.props;
---

<div class="graph">
	<canvas id="graph-canvas" aria-hidden="true"></canvas>
	<div id="graph-hud" class="hud" aria-hidden="true" hidden></div>

	<nav class="sr-only" aria-label="All work">
		<ul>
			{
				data.nodes.map((node) => (
					<li>
						<a href={`#work/${node.id}`} data-graph-focus={node.id}>
							{node.title} — {[node.section, ...node.tags].join(', ')}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</div>

<script id="graph-data" type="application/json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} is:inline></script>

<style>
	.graph {
		position: fixed;
		inset: 0;
		z-index: 1;
	}

	canvas {
		display: block;
		width: 100%;
		height: 100%;
		touch-action: none;
	}

	/* The hover preview reads as a specimen label pinned next to a marker on a
	   survey sheet: a hairline box, corner ticks, and one fact per row. It used
	   to be a tight glowing card — the box now has room to breathe, because
	   cramming eight tags onto one line was what made it unreadable. */
	.hud {
		position: absolute;
		z-index: 2;
		/* Anchored to the node's projected position, which the script writes as
		   left/top — so shift up and centre from there. graph.ts adds .below
		   when the box had to be flipped under its node for want of room. */
		transform: translate(-50%, -100%);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 1.15rem 1.3rem 1.05rem;
		width: max-content;
		min-width: 15rem;
		max-width: min(23rem, 80vw);
		background: var(--bg);
		border: 1px solid var(--rule);
		/* A drawn box, not a computed one — see the organic frames in
		   ../styles/global.css. */
		--o: 14px;
		border-radius: calc(var(--o) * 1.35) calc(var(--o) * 0.6) calc(var(--o) * 1.2)
			calc(var(--o) * 0.8) / calc(var(--o) * 0.7) calc(var(--o) * 1.4) calc(var(--o) * 0.65)
			calc(var(--o) * 1.25);
		/* Interactive, unlike a normal tooltip: the pointer has to be able to
		   travel onto it and press the open button. graph.ts keeps the box open
		   and frozen in place for as long as the pointer is inside it. */
		pointer-events: auto;
		text-align: left;
	}

	.hud.below {
		transform: translate(-50%, 0);
	}
	@media (max-width: 720px) {
		.hud {
			--o: 11px;
		}
	}

	/* Surveyor's corner ticks, drawn as two L-shaped borders rather than four
	   elements. */
	.hud::before,
	.hud::after {
		content: '';
		position: absolute;
		width: 9px;
		height: 9px;
		border: 1px solid var(--accent);
	}
	.hud::before {
		top: 5px;
		left: 5px;
		border-width: 1px 0 0 1px;
	}
	.hud::after {
		right: 5px;
		bottom: 5px;
		border-width: 0 1px 1px 0;
	}

	/* "collected under Grafix" — a caption-style line above the title that is
	   also the filter button for that category. */
	.hud :global(.hud-collection) {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
		text-align: left;
		border-bottom: 1px dotted transparent;
		transition: color 0.18s ease, border-color 0.18s ease;
	}
	.hud :global(.hud-collection-name) {
		color: var(--accent);
	}
	.hud :global(.hud-collection:hover),
	.hud :global(.hud-collection:focus-visible) {
		color: var(--fg);
		border-bottom-color: var(--accent);
	}

	.hud :global(.hud-title) {
		font-family: var(--font-headline);
		font-size: 1.15rem;
		line-height: 1.15;
		color: var(--fg);
	}

	/* One fact per row, label left, value right, dotted leader between — the
	   legend layout off an old map sheet. */
	.hud :global(.hud-rows) {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		width: 100%;
		padding-top: 0.7rem;
		border-top: 1px solid var(--rule);
	}
	.hud :global(.hud-row) {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		width: 100%;
	}
	.hud :global(.hud-key) {
		flex: none;
		width: 2.6rem;
		font-family: var(--font-mono);
		font-size: 0.58rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		opacity: 0.75;
	}
	.hud :global(.hud-value) {
		flex: 1;
		font-size: 0.78rem;
		line-height: 1.45;
		color: var(--fg);
	}

	.hud :global(.hud-cta) {
		margin-top: 0.1rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		line-height: 1.3;
		color: var(--accent);
		border-bottom: 1px solid transparent;
		transition: border-color 0.15s ease;
	}
	.hud :global(.hud-cta:hover),
	.hud :global(.hud-cta:focus-visible) {
		border-bottom-color: var(--accent);
	}

	@media (max-width: 720px) {
		.hud {
			padding: 0.95rem 1rem;
			gap: 0.6rem;
			min-width: 13rem;
		}
		.hud :global(.hud-title) {
			font-size: 1rem;
		}
	}
</style>

<script>
	import { initGraph } from '../scripts/graph';
	initGraph();
</script>
