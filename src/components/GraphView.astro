---
// The homepage itself: every work scattered in a 3D field and clustered by
// similarity. Canvas does the drawing (see ../scripts/graph.ts); the hover
// preview is a DOM element so it can be styled with real CSS rather than
// hand-measured on a canvas.
//
// The canvas is invisible to assistive tech, so the same works are also
// emitted as a visually-hidden list of links. Those links carry the same
// #work/<id> hashes the nodes do, so keyboard and screen-reader users open
// exactly the same windows by exactly the same mechanism.
import type { GraphData } from '../lib/graph';

interface Props {
	data: GraphData;
}

const { data } = Astro.props;
---

<div class="graph">
	<canvas id="graph-canvas" aria-hidden="true"></canvas>

	<nav class="sr-only" aria-label="All work">
		<ul>
			{
				data.nodes.map((node) => (
					<li>
						<a href={`#work/${node.id}`} data-graph-focus={node.id}>
							{node.title} — {[node.section, ...node.tags].join(', ')}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</div>

<!-- Deliberately a sibling of .graph, not a child: .graph sets z-index 1 and
     so traps everything inside it below the bottom bar. On a phone this
     preview is a sheet that has to cover the footer, which it can only do
     from outside that stacking context. -->
<div id="graph-hud" class="hud" aria-hidden="true" hidden></div>

<script id="graph-data" type="application/json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} is:inline></script>

<style>
	.graph {
		position: fixed;
		inset: 0;
		z-index: 1;
	}

	canvas {
		display: block;
		width: 100%;
		height: 100%;
		touch-action: none;
	}

	/* The hover preview reads as a specimen label pinned next to a marker on a
	   survey sheet: a hairline box, corner ticks, and one fact per row. It used
	   to be a tight glowing card — the box now has room to breathe, because
	   cramming eight tags onto one line was what made it unreadable. */
	.hud {
		position: fixed;
		/* Above the bottom bar (50), below the detail panel (60). */
		z-index: 55;
		/* Anchored to the node's projected position, which the script writes as
		   left/top — so shift up and centre from there. graph.ts adds .below
		   when the box had to be flipped under its node for want of room. */
		transform: translate(-50%, -100%);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 1.15rem 1.3rem 1.05rem;
		width: max-content;
		min-width: 15rem;
		max-width: min(23rem, 80vw);
		background: var(--bg);
		border: 1px solid var(--rule);
		/* A drawn box, not a computed one. Shape 1 from the organic frames in
		   ../styles/global.css, applied here rather than as a class because
		   the element is built in JS and never gets Astro's scoped classes. */
		--o: 13px;
		border-radius: calc(var(--o) * 2.3) calc(var(--o) * 0.4) calc(var(--o) * 1.6)
			calc(var(--o) * 0.85) / calc(var(--o) * 0.55) calc(var(--o) * 2.1)
			calc(var(--o) * 0.45) calc(var(--o) * 1.75);
		/* Interactive, unlike a normal tooltip: the pointer has to be able to
		   travel onto it and press the open button. graph.ts keeps the box open
		   and frozen in place for as long as the pointer is inside it. */
		pointer-events: auto;
		text-align: left;
	}

	.hud.below {
		transform: translate(-50%, 0);
	}

	/* Naming a work that isn't in the category being shown.

	   Deliberately not the full slip: that work isn't what's being looked at,
	   so a survey card for it would read as the selection having changed when
	   it hasn't. A name, tight to the dot, answers "what's that one?" and
	   nothing more — and because it can't be clicked into, it doesn't need to
	   be reachable by the pointer either. */
	.hud.bare {
		gap: 0;
		padding: 0.5rem 0.7rem 0.45rem;
		min-width: 0;
		border-style: dashed;
		pointer-events: none;
	}
	.hud.bare::before,
	.hud.bare::after {
		display: none;
	}
	.hud.bare :global(.hud-title) {
		font-size: 0.85rem;
	}
	/* Surveyor's corner ticks, drawn as two L-shaped borders rather than four
	   elements. */
	.hud::before,
	.hud::after {
		content: '';
		position: absolute;
		width: 9px;
		height: 9px;
		border: 1px solid var(--accent);
	}
	.hud::before {
		top: 5px;
		left: 5px;
		border-width: 1px 0 0 1px;
	}
	.hud::after {
		right: 5px;
		bottom: 5px;
		border-width: 0 1px 1px 0;
	}

	/* "collected under Grafix" — a caption-style line above the title that is
	   also the filter button for that category. */
	.hud :global(.hud-collection) {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
		text-align: left;
		border-bottom: 1px dotted transparent;
		transition: color 0.18s ease, border-color 0.18s ease;
	}
	.hud :global(.hud-collection-name) {
		color: var(--accent);
	}
	.hud :global(.hud-collection:hover),
	.hud :global(.hud-collection:focus-visible) {
		color: var(--fg);
		border-bottom-color: var(--accent);
	}

	.hud :global(.hud-title) {
		font-family: var(--font-headline);
		font-size: 1.15rem;
		line-height: 1.15;
		color: var(--fg);
	}

	/* One fact per row, label left, value right, dotted leader between — the
	   legend layout off an old map sheet. */
	.hud :global(.hud-rows) {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		width: 100%;
		padding-top: 0.7rem;
		border-top: 1px solid var(--rule);
	}
	.hud :global(.hud-row) {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		width: 100%;
	}
	.hud :global(.hud-key) {
		flex: none;
		width: 2.6rem;
		font-family: var(--font-mono);
		font-size: 0.58rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		opacity: 0.75;
	}
	.hud :global(.hud-value) {
		flex: 1;
		font-size: 0.78rem;
		line-height: 1.45;
		color: var(--fg);
	}

	.hud :global(.hud-cta) {
		margin-top: 0.1rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		line-height: 1.3;
		color: var(--accent);
		border-bottom: 1px solid transparent;
		transition: border-color 0.15s ease;
	}
	.hud :global(.hud-cta:hover),
	.hud :global(.hud-cta:focus-visible) {
		border-bottom-color: var(--accent);
	}

	/* --- Phone: the preview is a sheet, not a floating label ------------
	   Anchored to its node, the preview spent most of its life underneath the
	   legend in the top-left — the node it belonged to was often up there. So
	   on a phone it stops following the node and rises from the bottom edge
	   instead, over the footer, where there is always room for it and where a
	   thumb already is. graph.ts skips positioning entirely at this width. */
	@media (max-width: 720px) {
		.hud {
			--o: 18px;
			left: 0;
			right: 0;
			bottom: 0;
			top: auto;
			/* The JS writes left/top for the desktop anchor; override both. */
			transform: none !important;
			width: auto;
			max-width: none;
			min-width: 0;
			padding: 1.15rem var(--edge) calc(var(--edge) + 0.4rem);
			gap: 0.55rem;
			border-width: 1px 0 0;
			border-radius: calc(var(--o) * 1.9) calc(var(--o) * 0.8) 0 0 /
				calc(var(--o) * 1.15) calc(var(--o) * 1.6) 0 0;
			box-shadow: 0 -8px 28px rgba(0, 0, 0, 0.12);
			animation: hud-rise 0.32s cubic-bezier(0.32, 0.72, 0, 1);
		}
		/* The corner ticks are a desk-sheet detail; at this size they just
		   collide with the rounded top corners. */
		.hud::before,
		.hud::after {
			display: none;
		}
		.hud :global(.hud-title) {
			font-size: 1.15rem;
		}
		/* A real tap target, sitting where the thumb already is. */
		.hud :global(.hud-cta) {
			align-self: stretch;
			margin-top: 0.35rem;
			padding: 0.6rem 0;
			font-size: 0.78rem;
			text-align: center;
			border: 1px solid var(--accent);
			border-radius: 14px 5px 11px 7px / 7px 13px 6px 12px;
		}
		.hud :global(.hud-cta:hover),
		.hud :global(.hud-cta:focus-visible) {
			background: var(--accent);
			color: var(--bg);
		}
	}

	@keyframes hud-rise {
		from {
			transform: translateY(100%);
		}
		to {
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hud {
			animation: none;
		}
	}
</style>

<script>
	import { initGraph } from '../scripts/graph';
	initGraph();
</script>
