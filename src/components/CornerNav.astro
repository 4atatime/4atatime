---
// The one page that isn't a work: who this is and how to reach her. It used to
// be two bare words ("About", "Find") that were genuinely easy to miss against
// the graph, so it's a marker now — the same kind of thing as a node in the
// field, just standing on its own, with the same ripple the bubbles keep when
// you hover them (the CSS twin of drawRipples() in ../scripts/graph.ts).
//
// The glyph is a speech bubble that is also a face: the bubble is the
// "contact" half, the eyes and the smile are the "about" half. Drawn as one
// open, slightly-off outline rather than a symmetric one — an info "i" in a
// circle said nothing about this site, and read as a settings panel. The eyes
// are short strokes rather than dots because dots close up into blobs at the
// 17px this is actually shown at.
---

<nav class="cta" aria-label="Site">
	<a class="marker organic-4" href="#about">
		<span class="ripple organic-4" aria-hidden="true"></span>
		<span class="glyph" aria-hidden="true">
			<svg viewBox="0 0 24 24">
				<path
					d="M11.7 3.5c4.8-.4 8.7 2.5 8.9 6.8.2 4.3-3.3 7.8-8 8-1 .1-2 0-3-.2-1.5 1-3.1 1.7-4.9 2.1.7-1.3 1.2-2.6 1.4-3.8C3.8 15 2.7 13 2.6 10.8 2.4 6.6 6.3 3.8 11.7 3.5Z"
				></path>
				<path d="M8.4 10.2v1.3"></path>
				<path d="M14.8 10v1.3"></path>
				<path d="M9.8 13.8c1.4.9 2.9.8 4.4-.3"></path>
			</svg>
		</span>
		<span class="label">About &amp; Contact!</span>
	</a>
</nav>

<style>
	.cta {
		display: flex;
		align-items: stretch;
		pointer-events: auto;
	}

	.marker {
		--o: 11px;
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.62rem 1rem;
		background: var(--bg);
		border: 1px solid var(--rule);
		color: var(--fg);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			transform 0.12s ease;
	}
	.marker:hover,
	.marker:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
	}
	.marker:focus-visible {
		outline: 1px solid var(--accent);
		outline-offset: 3px;
	}
	/* Pressed: the marker takes the push, like a stamp going down. */
	.marker:active {
		transform: translateY(1px);
	}

	.glyph {
		display: grid;
		place-items: center;
		flex: none;
		width: 18px;
		height: 18px;
	}
	.glyph svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.label {
		font-family: var(--font-headline);
		font-size: 0.92rem;
		line-height: 1;
	}

	/* Two rings expanding out of the marker and fading, half a cycle apart, so
	   there's always one in flight — the same beat the graph bubbles keep. */
	.ripple {
		--o: 11px;
		position: absolute;
		inset: -1px;
		pointer-events: none;
	}
	.ripple::before,
	.ripple::after {
		content: '';
		position: absolute;
		inset: 0;
		border: 1px solid var(--accent);
		border-radius: inherit;
		opacity: 0;
	}
	.marker:hover .ripple::before,
	.marker:focus-visible .ripple::before,
	.marker:hover .ripple::after,
	.marker:focus-visible .ripple::after {
		animation: marker-ripple 2.6s ease-out infinite;
	}
	.marker:hover .ripple::after,
	.marker:focus-visible .ripple::after {
		animation-delay: 1.3s;
	}

	@keyframes marker-ripple {
		0% {
			transform: scale(1);
			opacity: 0;
		}
		12% {
			opacity: 0.4;
		}
		100% {
			transform: scale(1.3);
			opacity: 0;
		}
	}

	@media (max-width: 720px) {
		.marker {
			padding: 0.52rem 0.8rem;
			gap: 0.5rem;
		}
		.label {
			font-size: 0.84rem;
		}
		.glyph {
			width: 16px;
			height: 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marker {
			transition: none;
		}
		.marker:hover .ripple::before,
		.marker:focus-visible .ripple::before,
		.marker:hover .ripple::after,
		.marker:focus-visible .ripple::after {
			animation: none;
		}
	}
</style>
