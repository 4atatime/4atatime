---
// The one page that isn't a work: who this is and how to reach her. It used to
// be two bare words ("About", "Find") that were genuinely easy to miss against
// the graph, so it's a marker now — the same kind of thing as a node in the
// field, just standing on its own, with the same ripple the bubbles keep when
// you hover them (the CSS twin of drawRipples() in ../scripts/graph.ts).
//
// The glyph is a fish, drawn as three open strokes: body, tail, eye. Nothing
// about it is symmetric — the body's two arcs don't match and the tail sits
// slightly high — because a fish snapped to a grid reads as clip art. Tested
// down to 14px, which is where the earlier attempts (a waving hand, a snail)
// turned to mush: anything with more than three strokes closes up at this
// size, so the gills and fins that make it *more* fish-like on paper are
// exactly what has to go.
---

<nav class="cta" aria-label="Site">
	<a class="marker organic-4" href="#about">
		<span class="ripple organic-4" aria-hidden="true"></span>
		<span class="glyph" aria-hidden="true">
			<svg viewBox="0 0 24 24">
				<path
					d="M14.6 7.2c2.6.8 4.4 2.5 5.1 4.7-.9 2.3-2.8 4-5.4 4.7-3.6 1-7.3-.4-9.4-3.4-.4-.6-.4-1.3 0-1.9 2.2-2.9 6-4.2 9.7-4.1"
				></path>
				<path d="M19.9 11.7c.8-.8 1.6-1.5 2.4-2.1.3 1.6.3 3.3 0 5-.9-.5-1.7-1.1-2.4-1.9"></path>
				<path d="M9.3 11.4c.5-.1.9.3.9.8 0 .4-.4.8-.8.8-.5 0-.8-.4-.8-.8 0-.4.3-.8.7-.8"></path>
			</svg>
		</span>
		<span class="label">About &amp; Contact!</span>
	</a>
</nav>

<style>
	.cta {
		display: flex;
		align-items: stretch;
		pointer-events: auto;
	}

	.marker {
		--o: 11px;
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.62rem 1rem;
		background: var(--bg);
		border: 1px solid var(--rule);
		color: var(--fg);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			transform 0.12s ease;
	}
	.marker:hover,
	.marker:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
	}
	.marker:focus-visible {
		outline: 1px solid var(--accent);
		outline-offset: 3px;
	}
	/* Pressed: the marker takes the push, like a stamp going down. */
	.marker:active {
		transform: translateY(1px);
	}

	.glyph {
		display: grid;
		place-items: center;
		flex: none;
		width: 18px;
		height: 18px;
	}
	.glyph svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.label {
		font-family: var(--font-headline);
		font-size: 0.92rem;
		line-height: 1;
	}

	/* Two rings expanding out of the marker and fading, half a cycle apart, so
	   there's always one in flight — the same beat the graph bubbles keep. */
	.ripple {
		--o: 11px;
		position: absolute;
		inset: -1px;
		pointer-events: none;
	}
	.ripple::before,
	.ripple::after {
		content: '';
		position: absolute;
		inset: 0;
		border: 1px solid var(--accent);
		border-radius: inherit;
		opacity: 0;
	}
	.marker:hover .ripple::before,
	.marker:focus-visible .ripple::before,
	.marker:hover .ripple::after,
	.marker:focus-visible .ripple::after {
		animation: marker-ripple 2.6s ease-out infinite;
	}
	.marker:hover .ripple::after,
	.marker:focus-visible .ripple::after {
		animation-delay: 1.3s;
	}

	@keyframes marker-ripple {
		0% {
			transform: scale(1);
			opacity: 0;
		}
		12% {
			opacity: 0.4;
		}
		100% {
			transform: scale(1.3);
			opacity: 0;
		}
	}

	@media (max-width: 720px) {
		.marker {
			padding: 0.52rem 0.8rem;
			gap: 0.5rem;
		}
		.label {
			font-size: 0.84rem;
		}
		.glyph {
			width: 16px;
			height: 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marker {
			transition: none;
		}
		.marker:hover .ripple::before,
		.marker:focus-visible .ripple::before,
		.marker:hover .ripple::after,
		.marker:focus-visible .ripple::after {
			animation: none;
		}
	}
</style>
