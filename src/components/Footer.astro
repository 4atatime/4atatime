---
const year = new Date().getFullYear();
---

<footer>&copy; {year} Lexie Yu. All rights reserved.</footer>

<style>
	/* Positioned by the bottom bar in index.astro, which keeps it on the same
	   baseline as the About/Find links at the other end. */
	footer {
		margin: 0;
		font-size: 12px;
		line-height: 1;
		color: var(--muted);
		opacity: 0.4;
	}
	@media (max-width: 720px) {
		footer {
			font-size: 11px;
		}
	}
</style>
