---
// One window, reused for every panel (a work, About, Find). Content is cloned
// in from <template> elements by ../scripts/window.ts.
//
// It docks rather than floating: half the screen on desktop, a tall sheet on
// mobile. Docking is what keeps the graph visible and still interactive beside
// an open work, which a centred modal with a backdrop would throw away.
---

<aside
	id="detail-window"
	class="window"
	role="dialog"
	aria-modal="false"
	aria-label="Details"
	hidden
>
	<div id="detail-resizer" class="resizer" role="separator" aria-orientation="vertical" aria-label="Resize window (double-click to reset)"></div>
	<button type="button" id="detail-close" class="close" aria-label="Close">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
	</button>
	<div id="detail-body" class="body"></div>
</aside>

<style>
	.window {
		position: fixed;
		z-index: 60;
		display: flex;
		flex-direction: column;
		background: var(--bg);
		color: var(--fg);
		box-shadow: var(--shadow);
		overflow: hidden;
	}

	/* Desktop: right-hand dock, half the viewport by default. */
	@media (min-width: 721px) {
		.window {
			top: 0;
			right: 0;
			bottom: 0;
			width: var(--window-width, 50vw);
			min-width: 320px;
			max-width: calc(100vw - 48px);
			border-left: 1px solid var(--border);
			transform: translateX(100%);
			transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
		}
		.resizer {
			top: 0;
			left: 0;
			bottom: 0;
			width: 10px;
			cursor: ew-resize;
		}
		.resizer::after {
			top: 50%;
			left: 4px;
			width: 2px;
			height: 46px;
			margin-top: -23px;
		}
	}

	/* Mobile: a sheet that rises over everything, including the preview sheet
	   it was opened from. It stops a hair short of the top so there's still
	   something behind it to tap, and so the drag handle reads as a handle. */
	@media (max-width: 720px) {
		.window {
			left: 0;
			right: 0;
			bottom: 0;
			height: var(--window-height, calc(100dvh - 1.5rem));
			min-height: 220px;
			max-height: calc(100dvh - 1.5rem);
			border-top: 1px solid var(--border);
			--o: 20px;
			border-radius: calc(var(--o) * 1.9) calc(var(--o) * 0.75) 0 0 /
				calc(var(--o) * 1.1) calc(var(--o) * 1.7) 0 0;
			transform: translateY(100%);
			transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
		}
		.resizer {
			top: 0;
			left: 0;
			right: 0;
			height: 18px;
			cursor: ns-resize;
		}
		.resizer::after {
			top: 7px;
			left: 50%;
			width: 34px;
			height: 3px;
			margin-left: -17px;
		}
	}

	.window.open {
		transform: none;
	}
	/* Sliding back out. Without this the panel keeps .open's `transform: none`
	   until it's hidden outright, which is no animation at all — the media
	   blocks above already define where "out" is, so this only has to stop
	   .open winning. */
	.window.closing {
		transform: translateX(100%);
	}
	@media (max-width: 720px) {
		.window.closing {
			transform: translateY(100%);
		}
	}
	/* Suppress the slide transition mid-drag so resizing tracks the pointer. */
	.window.resizing {
		transition: none;
	}

	.resizer {
		position: absolute;
		z-index: 2;
		touch-action: none;
	}
	.resizer::after {
		content: '';
		position: absolute;
		background: var(--border);
		border-radius: 999px;
		transition: background 0.2s ease;
	}
	.resizer:hover::after,
	.window.resizing .resizer::after {
		background: var(--accent);
	}

	.close {
		position: absolute;
		top: var(--edge);
		right: var(--edge);
		z-index: 3;
		width: 30px;
		height: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: var(--bg);
		color: var(--muted);
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.close:hover,
	.close:focus-visible {
		color: var(--fg);
		border-color: var(--fg);
	}
	.close svg {
		width: 13px;
		height: 13px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
	}

	/* The same inset the page uses at its own corners, so a panel heading sits
	   the same distance from the panel's edge as the logo does from the
	   window's. Content that wants a bigger drop (a work's survey slip) adds
	   its own padding on top of this rather than this one being generous for
	   everybody. */
	.body {
		flex: 1;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: var(--edge);
		padding-bottom: calc(var(--edge) * 2.5);
	}

	@media (prefers-reduced-motion: reduce) {
		.window {
			transition: none;
		}
	}
</style>

<script>
	import { initWindow } from '../scripts/window';
	initWindow();
</script>
