---
// One window, reused for every panel (a work, About, Find). Content is cloned
// in from <template> elements by ../scripts/window.ts.
//
// It docks rather than floating: half the screen on desktop, a tall sheet on
// mobile. Docking is what keeps the graph visible and still interactive beside
// an open work, which a centred modal with a backdrop would throw away.
---

<aside
	id="detail-window"
	class="window"
	role="dialog"
	aria-modal="false"
	aria-label="Details"
	hidden
>
	<div id="detail-resizer" class="resizer" role="separator" aria-orientation="vertical" aria-label="Resize window (double-click to reset)"></div>
	<button type="button" id="detail-close" class="close" aria-label="Close">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
	</button>
	<div id="detail-body" class="body"></div>
</aside>

<style>
	.window {
		position: fixed;
		z-index: 60;
		display: flex;
		flex-direction: column;
		background: var(--bg);
		color: var(--fg);
		box-shadow: var(--shadow);
		overflow: hidden;
	}

	/* Desktop: right-hand dock, half the viewport by default. */
	@media (min-width: 721px) {
		.window {
			top: 0;
			right: 0;
			bottom: 0;
			width: var(--window-width, 50vw);
			min-width: 320px;
			max-width: calc(100vw - 48px);
			border-left: 1px solid var(--border);
			transform: translateX(100%);
			transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
		}
		.resizer {
			top: 0;
			left: 0;
			bottom: 0;
			width: 10px;
			cursor: ew-resize;
		}
		.resizer::after {
			top: 50%;
			left: 4px;
			width: 2px;
			height: 46px;
			margin-top: -23px;
		}
	}

	/* Mobile: bottom sheet over most of the screen. */
	@media (max-width: 720px) {
		.window {
			left: 0;
			right: 0;
			bottom: 0;
			height: var(--window-height, 88vh);
			min-height: 220px;
			max-height: calc(100vh - 24px);
			border-top: 1px solid var(--border);
			border-radius: 14px 14px 0 0;
			transform: translateY(100%);
			transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
		}
		.resizer {
			top: 0;
			left: 0;
			right: 0;
			height: 18px;
			cursor: ns-resize;
		}
		.resizer::after {
			top: 7px;
			left: 50%;
			width: 34px;
			height: 3px;
			margin-left: -17px;
		}
	}

	.window.open {
		transform: none;
	}
	/* Suppress the slide transition mid-drag so resizing tracks the pointer. */
	.window.resizing {
		transition: none;
	}

	.resizer {
		position: absolute;
		z-index: 2;
		touch-action: none;
	}
	.resizer::after {
		content: '';
		position: absolute;
		background: var(--border);
		border-radius: 999px;
		transition: background 0.2s ease;
	}
	.resizer:hover::after,
	.window.resizing .resizer::after {
		background: var(--accent);
	}

	.close {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		z-index: 3;
		width: 30px;
		height: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: var(--bg);
		color: var(--muted);
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.close:hover,
	.close:focus-visible {
		color: var(--fg);
		border-color: var(--fg);
	}
	.close svg {
		width: 13px;
		height: 13px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
	}

	.body {
		flex: 1;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 3.2rem clamp(1.25rem, 4vw, 3rem) clamp(2rem, 6vw, 4rem);
	}

	@media (prefers-reduced-motion: reduce) {
		.window {
			transition: none;
		}
	}
</style>

<script>
	import { initWindow } from '../scripts/window';
	initWindow();
</script>
